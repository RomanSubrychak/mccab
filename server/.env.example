PORT=3000
DATABASE_URL="postgresql://<your-username>@localhost:5432/rideshare"
JWT_SECRET=change-me
# Only emails at this domain can sign up. Leave empty to allow any email.
ALLOWED_EMAIL_DOMAIN=
# Email for verification codes. Leave SMTP_HOST empty in development to print
# codes in the server console instead of emailing them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who the email comes from. Defaults to SMTP_USER. Use a plain address: a
# brand name on a personal Gmail (e.g. "MCCab <x@gmail.com>") gets filtered.
EMAIL_FROM=
