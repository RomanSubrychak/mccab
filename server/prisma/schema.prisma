// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String
  passwordHash   String
  // Part of every login token. Changing or resetting the password increases it,
  // which signs out every device that still has an older token.
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  passwordResets PasswordReset[]
  vehicle        Vehicle?
  ridesDriven    Ride[]
  bookings       Booking[]

  // Null until the user enters the code from their verification email.
  // Unverified accounts are inactive: they can't sign in.
  emailVerifiedAt DateTime?

  // The current code. Cleared once the email is verified.
  verificationCodeHash      String?
  verificationCodeExpiresAt DateTime?
  verificationCodeSentAt    DateTime?
  verificationAttempts      Int       @default(0)

  // About me
  phone          String? // E.164, e.g. +13125550123
  bio            String?
  major          String?
  graduationYear Int?
  rideRole       RideRole? // null until the student picks one after accepting the terms
  // What a RIDER_DRIVER is doing right now. RIDER is always riding and DRIVER
  // always driving. DRIVING needs a valid licence and a car (see routes/me.ts).
  activeMode     RideMode        @default(RIDING)

  // When the student agreed to the Terms and Conditions. null means not yet.
  termsAcceptedAt DateTime?

  // My route
  campus      Campus?
  // Public: neighbourhood or city, never a street address. Safe to show other
  // students. Set from the home address (see lib/places.ts).
  homeArea    String?
  // Private: the exact home address and its coordinates. Only the student sees
  // them; they're for matching and, later, a pickup point after a ride is confirmed.
  homeAddress String?
  homeLat     Float?
  homeLng     Float?
  rideDays    Weekday[]
  arriveBy    String? // "HH:MM", 24-hour
  leaveAt     String? // "HH:MM", 24-hour

  // Ride preferences
  pricePerSeatCents Int? // Drivers only
  chatPreference    ChatPreference @default(SOME)
  musicOk           Boolean        @default(true)
  smokingOk         Boolean        @default(false)

  // Driver's licence. Only the last 4 characters of the number are stored.
  licenceState     String? // Two-letter US state, e.g. "IL"
  licenceLast4     String?
  licenceExpiresOn DateTime? @db.Date

  // Car insurance. Only the last 4 characters of the policy number are stored.
  insuranceProvider    String?
  insurancePolicyLast4 String?
  insuranceExpiresOn   DateTime? @db.Date

  // Safety
  emergencyContactName  String?
  emergencyContactPhone String? // E.164
  phoneVisibility       PhoneVisibility @default(CONFIRMED_RIDES)

  // Notifications
  notifyRideUpdates Boolean @default(true)
  notifyMessages    Boolean @default(true)
  notifyNews        Boolean @default(false)
}

// One car per driver.
model Vehicle {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  make      String
  model     String
  year      Int?
  color     String
  plate     String
  seats     Int // Seats offered to riders: 1 to 3
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// RIDER only books seats, DRIVER only offers them, RIDER_DRIVER does both and
// switches between the two with activeMode.
enum RideRole {
  RIDER
  DRIVER
  RIDER_DRIVER
}

enum RideMode {
  RIDING
  DRIVING
}

// MCC campuses in the Chicago area.
enum Campus {
  CHICAGO_MAIN
  CHICAGO_DOWNTOWN
  NAPERVILLE
  EVERGREEN_PARK
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ChatPreference {
  QUIET
  SOME
  CHATTY
}

// A ride goes from the driver's home area to the campus (TO_CAMPUS), or from
// the campus back to it (FROM_CAMPUS).
enum RideDirection {
  TO_CAMPUS
  FROM_CAMPUS
}

enum RideStatus {
  OPEN
  CANCELLED // By the driver. Its bookings are cancelled too.
  COMPLETED // Set by the server once departAt has passed
}

enum BookingStatus {
  REQUESTED // Waiting for the driver
  ACCEPTED // Seat confirmed: contact details are shared
  DECLINED // By the driver
  CANCELLED // By the rider, or because the ride was cancelled
}

// Who can see the user's phone number.
enum PhoneVisibility {
  CONFIRMED_RIDES // Only people in a confirmed ride with them
  NOBODY
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One trip a driver offers to or from a campus, on one date (no repeating
// rides yet). "Full" isn't stored: free seats are seatsOffered minus the
// ACCEPTED bookings, so they can't fall out of sync. Payment happens outside
// the app; the price is only shown.
model Ride {
  id                Int           @id @default(autoincrement())
  driverId          Int
  campus            Campus
  direction         RideDirection
  departAt          DateTime
  seatsOffered      Int // 1 to 3, and at most the car's seats when posted
  pricePerSeatCents Int
  // The off-campus end of the trip: where a TO_CAMPUS ride starts and a
  // FROM_CAMPUS ride ends. Copied from the driver's home when the ride is posted.
  // startArea is public (neighbourhood or city). startLat/startLng are private,
  // only used for distance, and never sent to the app.
  startArea         String
  startLat          Float
  startLng          Float
  notes             String? // Up to 200 characters
  status            RideStatus    @default(OPEN)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  driver            User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  bookings          Booking[]

  @@index([campus, departAt])
  @@index([driverId])
}

// One rider's seat on one ride. A rider has at most one booking per ride;
// asking again after cancelling reuses it.
model Booking {
  id        Int           @id @default(autoincrement())
  rideId    Int
  riderId   Int
  status    BookingStatus @default(REQUESTED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ride      Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  rider     User          @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@unique([rideId, riderId])
  @@index([riderId])
}
