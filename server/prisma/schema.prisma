// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String
  passwordHash   String
  // Part of every login token. Changing or resetting the password increases it,
  // which signs out every device that still has an older token.
  tokenVersion   Int             @default(0)
  createdAt      DateTime        @default(now())
  passwordResets PasswordReset[]
  vehicle        Vehicle?

  // About me
  phone          String? // E.164, e.g. +13125550123
  bio            String?
  major          String?
  graduationYear Int?
  rideRole       RideRole        @default(RIDER)

  // My route
  campus   Campus?
  homeArea String? // Neighbourhood or area, never a full street address
  rideDays Weekday[]
  arriveBy String? // "HH:MM", 24-hour
  leaveAt  String? // "HH:MM", 24-hour

  // Ride preferences
  pricePerSeatCents Int? // Drivers only
  chatPreference    ChatPreference @default(SOME)
  musicOk           Boolean        @default(true)
  smokingOk         Boolean        @default(false)

  // Safety
  emergencyContactName  String?
  emergencyContactPhone String? // E.164
  phoneVisibility       PhoneVisibility @default(CONFIRMED_RIDES)

  // Notifications
  notifyRideUpdates Boolean @default(true)
  notifyMessages    Boolean @default(true)
  notifyNews        Boolean @default(false)
}

// One car per driver.
model Vehicle {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  make      String
  model     String
  year      Int?
  color     String
  plate     String
  seats     Int // Seats offered to riders: 1 to 3
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RideRole {
  RIDER
  DRIVER
  BOTH
}

// MCC campuses in the Chicago area.
enum Campus {
  CHICAGO_MAIN
  CHICAGO_DOWNTOWN
  NAPERVILLE
  EVERGREEN_PARK
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum ChatPreference {
  QUIET
  SOME
  CHATTY
}

// Who can see the user's phone number.
enum PhoneVisibility {
  CONFIRMED_RIDES // Only people in a confirmed ride with them
  NOBODY
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
